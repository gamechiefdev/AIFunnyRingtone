<?xml version="1.0" encoding="utf-8"?>
<!-- signature "aurora" wash: three soft colour bloom over warm cream -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.88"
                android:centerY="0.10"
                android:gradientRadius="280dp"
                android:startColor="#4DFF4D8D"
                android:endColor="#00FF4D8D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.05"
                android:centerY="0.42"
                android:gradientRadius="300dp"
                android:startColor="#338B5CF6"
                android:endColor="#008B5CF6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.70"
                android:centerY="0.92"
                android:gradientRadius="320dp"
                android:startColor="#3838BDF8"
                android:endColor="#0038BDF8" />
        </shape>
    </item>
</layer-list>
