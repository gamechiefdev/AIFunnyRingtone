<?xml version="1.0" encoding="utf-8"?>
<!-- 3D material card: soft top gloss over a warm white body + hairline edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/pin_radius_lg" />
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:centerColor="#FDFBF8"
                android:endColor="#F7F4EF" />
            <stroke android:width="1dp" android:color="#EFE9E1" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/pin_radius_lg" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
