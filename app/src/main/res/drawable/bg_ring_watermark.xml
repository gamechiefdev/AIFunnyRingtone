<?xml version="1.0" encoding="utf-8"?>
<!-- concentric "ring" motif — app ringtone ka signature watermark -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center" android:width="220dp" android:height="220dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#26FF4D8D" />
        </shape>
    </item>
    <item android:gravity="center" android:width="168dp" android:height="168dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#228B5CF6" />
        </shape>
    </item>
    <item android:gravity="center" android:width="118dp" android:height="118dp">
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="#1E188E5A" />
        </shape>
    </item>
    <item android:gravity="center" android:width="68dp" android:height="68dp">
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="#1C38BDF8" />
        </shape>
    </item>
</layer-list>
