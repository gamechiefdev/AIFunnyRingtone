<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="wrap_content"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/activity_main_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Existing ConstraintLayout for top bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_55sdp"
            android:background="@color/white"
            android:fitsSystemWindows="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Funny Ringtones"
                android:textColor="@color/black"
                android:textSize="@dimen/_15sdp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/fav"
                app:layout_constraintStart_toEndOf="@+id/menuOpen"
                app:layout_constraintTop_toTopOf="parent" />


            <androidx.appcompat.widget.Toolbar
                android:id="@+id/menuOpen"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                app:navigationIcon="@drawable/menu_bar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />


            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/premiumOpen"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                app:lottie_rawRes="@raw/pro"
                app:lottie_loop="true"
                app:lottie_autoPlay="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <ImageView
                android:id="@+id/fav"
                android:layout_width="@dimen/_30ssp"
                android:layout_height="@dimen/_30ssp"
                android:layout_marginStart="@dimen/_20sdp"
                android:scaleType="centerCrop"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/fav_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/premiumOpen"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>






        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPagerNailArt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@+id/bottomLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout">

        </androidx.viewpager.widget.ViewPager>


        <LinearLayout
            android:id="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/adView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">




            <FrameLayout
                android:id="@+id/bottom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50sdp"
                android:background="@color/purple_200"
                app:layout_constraintBottom_toTopOf="@+id/adView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <ImageView
                            android:id="@+id/homeTxt"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:src="@drawable/home"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10ssp" />
                        <ImageView
                            android:id="@+id/prank"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:src="@drawable/prank_call"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10ssp" />

                        <ImageView
                            android:id="@+id/dualTxt"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:src="@drawable/wallpaper"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10ssp" />
<!--                        <ImageView-->
<!--                            android:id="@+id/cutter"-->
<!--                            android:layout_width="0dp"-->
<!--                            android:layout_height="@dimen/_18sdp"-->
<!--                            android:layout_gravity="center"-->
<!--                            android:layout_weight="1"-->
<!--                            android:gravity="center"-->
<!--                            android:src="@drawable/ic_cut"-->
<!--                            android:textColor="@color/black"-->
<!--                            android:textSize="@dimen/_10ssp" />-->

                        <ImageView
                            android:id="@+id/darkTxt"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:src="@drawable/playlist"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10ssp" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:weightSum="4">
                        <TextView
                            android:id="@+id/homTxt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Home"
                            android:textColor="#5B2F08"
                            android:textSize="@dimen/_9ssp" />

                        <TextView
                            android:id="@+id/prankTxt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Prank Call"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_9ssp" />
                        <TextView
                            android:id="@+id/listTxt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Wallpapers"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_9ssp" />

<!--                        <TextView-->
<!--                            android:id="@+id/cutterTxt"-->
<!--                            android:layout_width="0dp"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:layout_gravity="center"-->
<!--                            android:layout_weight="1"-->
<!--                            android:gravity="center"-->
<!--                            android:text="Mp3 Cut"-->
<!--                            android:textColor="@color/white"-->
<!--                            android:textSize="@dimen/_9ssp" />-->
                        <TextView
                            android:id="@+id/favTxt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="AI Playlist"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_9ssp" />
                    </LinearLayout>
                </LinearLayout>





            </FrameLayout>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/NavigationViewDpMaker"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:layout_marginBottom="@dimen/_110sdp"
        app:headerLayout="@layout/headerfile"
        app:menu="@menu/navigation_drawer"
        app:itemIconTint="@color/purple_200"
        app:itemTextColor="@color/purple_200"
        android:layout_gravity="start"/>

</androidx.drawerlayout.widget.DrawerLayout>