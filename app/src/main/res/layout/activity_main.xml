<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/activity_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pin_bg">

        <!-- ============================ APP BAR ============================ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/pin_bg"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_6sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/menuOpen"
                android:layout_width="@dimen/pin_icon_button"
                android:layout_height="@dimen/pin_icon_button"
                android:layout_marginStart="@dimen/pin_screen_pad"
                android:background="@drawable/bg_circle_white"
                android:elevation="0dp"
                android:padding="@dimen/_10sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:navigationIcon="@drawable/menu_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@+id/menuOpen"
                app:layout_constraintEnd_toStartOf="@+id/fav"
                app:layout_constraintStart_toEndOf="@+id/menuOpen"
                app:layout_constraintTop_toTopOf="@+id/menuOpen">

                <TextView
                    android:id="@+id/textView5"
                    style="@style/Pin.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discover" />

                <TextView
                    style="@style/Pin.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Funny sounds &amp; wallpapers" />
            </LinearLayout>

            <ImageView
                android:id="@+id/fav"
                android:layout_width="@dimen/pin_icon_button"
                android:layout_height="@dimen/pin_icon_button"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@string/favorites"
                android:padding="@dimen/_11sdp"
                app:layout_constraintBottom_toBottomOf="@+id/menuOpen"
                app:layout_constraintEnd_toStartOf="@+id/premiumOpen"
                app:layout_constraintTop_toTopOf="@+id/menuOpen" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/premiumOpen"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginEnd="@dimen/pin_screen_pad"
                app:layout_constraintBottom_toBottomOf="@+id/menuOpen"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/menuOpen"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/pro" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ============================ CONTENT ============================ -->
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPagerNailArt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@+id/bottomLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout" />

        <!-- ============================ BOTTOM NAV ============================ -->
        <LinearLayout
            android:id="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/adView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <FrameLayout
                android:id="@+id/bottom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pin_navbar_height"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_nav_pill"
                android:elevation="14dp"
                app:layout_constraintBottom_toTopOf="@+id/adView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <!-- Sliding selection pill (positioned from MainActivity) -->
                <View
                    android:id="@+id/navIndicator"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_4sdp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="@dimen/_7sdp"
                    android:background="@drawable/bg_nav_indicator_dark" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/homeTxt"
                            android:layout_width="@dimen/pin_icon"
                            android:layout_height="@dimen/pin_icon"
                            android:contentDescription="@string/home"
                            android:src="@drawable/home" />

                        <TextView
                            android:id="@+id/homTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="Home"
                            android:textColor="@color/nav_selected"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/prank"
                            android:layout_width="@dimen/pin_icon"
                            android:layout_height="@dimen/pin_icon"
                            android:contentDescription="@string/prank_calls"
                            android:src="@drawable/prank_call" />

                        <TextView
                            android:id="@+id/prankTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="Prank Call"
                            android:textColor="@color/nav_unselected"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/dualTxt"
                            android:layout_width="@dimen/pin_icon"
                            android:layout_height="@dimen/pin_icon"
                            android:contentDescription="@string/wallpapers"
                            android:src="@drawable/wallpaper" />

                        <TextView
                            android:id="@+id/listTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="Wallpapers"
                            android:textColor="@color/nav_unselected"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/darkTxt"
                            android:layout_width="@dimen/pin_icon"
                            android:layout_height="@dimen/pin_icon"
                            android:contentDescription="@string/ai_playlist"
                            android:src="@drawable/playlist" />

                        <TextView
                            android:id="@+id/favTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="AI Playlist"
                            android:textColor="@color/nav_unselected"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/NavigationViewDpMaker"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white"
        app:headerLayout="@layout/headerfile"
        app:itemIconTint="@color/pin_primary"
        app:itemTextColor="@color/pin_ink_soft"
        app:menu="@menu/navigation_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
