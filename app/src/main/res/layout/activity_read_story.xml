<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pin_bg"
    tools:context=".activities.ReadStory">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout00"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/pin_bg"
        android:paddingTop="@dimen/_10sdp" android:paddingBottom="@dimen/_8sdp" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView7"
            android:layout_width="@dimen/pin_icon_button"
            android:layout_height="@dimen/pin_icon_button"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/pin_screen_pad"
            android:padding="@dimen/_11sdp"
            android:src="@drawable/back"
            android:background="@drawable/bg_circle_white" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="Story"
            android:textStyle="bold"
            android:textColor="@color/grey"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintStart_toStartOf="@+id/imageView7"
            app:layout_constraintTop_toTopOf="parent" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/changeLang"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_rawRes="@raw/change_lang"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            />




    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialCardView4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        android:theme="@style/Theme.MaterialComponents.Light"
        app:cardCornerRadius="7dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_btm"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout00">




        <ScrollView
            android:layout_width="match_parent"
            android:background="@color/light"

            android:layout_height="match_parent">
            <me.grantland.widget.AutofitTextView
                android:id="@+id/getStory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center"
                android:padding="10dp"
                android:text="The quick brown fox jumps over the lazy dog"
                android:textColor="@color/pin_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:minTextSize="12sp" />
        </ScrollView>



    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/ll_btm"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:paddingVertical="3dp"
        android:weightSum="2"
        app:layout_constraintBottom_toTopOf="@+id/adView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        >

        <!--        <ImageView-->
        <!--            android:id="@+id/btn1_like_row_vi"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="match_parent"-->
        <!--            android:layout_weight="1"-->
        <!--            android:gravity="center"-->
        <!--            android:padding="10dp"-->
        <!--            android:src="@drawable/fav_icon" />-->


        <ImageView
            android:id="@+id/btn3_copy_row_vi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:src="@drawable/ic_copy" />


        <ImageView
            android:id="@+id/btn4_share_row_vi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:src="@drawable/ic_share" />


    </LinearLayout>

    <FrameLayout
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>