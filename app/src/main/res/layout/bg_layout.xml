<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_210sdp"
    android:layout_margin="@dimen/_5sdp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/pin_radius_lg"
    app:cardElevation="@dimen/_2sdp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/bgImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/wall1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/view00"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#4D5F5C5C"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/bgImage"
            app:layout_constraintEnd_toEndOf="@+id/bgImage"
            app:layout_constraintStart_toStartOf="@+id/bgImage"
            app:layout_constraintTop_toTopOf="@+id/bgImage" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/_70sdp"
            android:background="@drawable/scrim_bottom"
            app:layout_constraintBottom_toBottomOf="@+id/bgImage"
            app:layout_constraintEnd_toEndOf="@+id/bgImage"
            app:layout_constraintStart_toStartOf="@+id/bgImage" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_24sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:background="@drawable/bg_badge_dark"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:text="Tap to set"
            android:textColor="@color/white"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="@+id/bgImage"
            app:layout_constraintStart_toStartOf="@+id/bgImage" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
