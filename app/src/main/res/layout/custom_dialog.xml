<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:id="@+id/constrains"
    android:background="@color/black"
    android:layout_height="match_parent">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:background="@drawable/bg_pin_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="2dp"
            app:strokeColor="@color/pin_ink">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:background="@color/white"
            android:layout_height="470dp">

            <ImageView
                android:id="@+id/closeImage"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/baseline_close_24"
                app:layout_constraintBottom_toTopOf="@+id/profileImageCalling"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.929"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.8" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profileImageCalling"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/ic_launcher_foreground"
                app:civ_border_color="@color/purple_200"
                app:civ_border_width="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textnameCalling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:text=""
                android:textColor="@color/pin_ink"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profileImageCalling" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textnameCalling">


                                <RelativeLayout
                                    android:id="@+id/VideoCall"
                                    android:layout_width="140dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="15dp"
                                    android:background="@drawable/home_bg_prank"
                                    app:layout_constraintEnd_toStartOf="@+id/VoiceCall"
                                    app:layout_constraintHorizontal_bias="0.125"
                                    app:layout_constraintStart_toStartOf="parent"
                                    >


                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:layout_marginStart="15dp"
                                        android:layout_marginTop="5dp"
                                        android:paddingRight="5dp"
                                        android:src="@drawable/baseline_video_call_24" />

                                    <TextView
                                        android:layout_width="140dp"
                                        android:layout_height="40dp"
                                        android:layout_marginStart="20sp"
                                        android:gravity="center"
                                        android:text="Video Call"
                                        android:textColor="@color/white"
                                        android:textStyle="bold"
                                        app:layout_constraintEnd_toEndOf="parent"

                                        />

                                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/VoiceCall"
                    android:layout_width="140dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/home_bg_prank"
                    app:layout_constraintEnd_toEndOf="parent"

                    app:layout_constraintHorizontal_bias="0.125"

                    >


                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="5dp"
                        android:paddingRight="5dp"
                        android:src="@drawable/baseline_call_24" />

                    <TextView
                        android:layout_width="140dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="20sp"
                        android:gravity="center"
                        android:text="Voice Call"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"

                        />

                </RelativeLayout>


            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>