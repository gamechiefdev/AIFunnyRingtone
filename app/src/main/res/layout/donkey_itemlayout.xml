<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_margin="@dimen/_5sdp"
    android:layout_height="wrap_content">


    <ImageView
        android:id="@+id/donkeyImg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_160sdp"
        android:src="@drawable/donkey1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/donkey_play"
        app:layout_constraintBottom_toTopOf="@+id/donkeyTxt0"
        app:layout_constraintEnd_toEndOf="@+id/donkeyImg"
        app:layout_constraintStart_toStartOf="@+id/donkeyImg"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/donkeyTxt0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Donkey 1"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="@dimen/_13ssp"
        android:textColor="@color/pin_ink"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/donkeyImg" />
    <TextView
        android:id="@+id/donkeyTxt1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="The Dancing King"
        android:gravity="center"
        android:textColor="@color/pin_ink"

        android:textStyle="bold"
        android:textSize="@dimen/_9ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/donkeyTxt0" />
</androidx.constraintlayout.widget.ConstraintLayout>