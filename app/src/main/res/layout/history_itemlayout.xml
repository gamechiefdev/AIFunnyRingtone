<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:paddingStart="@dimen/pin_screen_pad"
    android:paddingTop="@dimen/_4sdp"
    android:paddingEnd="@dimen/pin_screen_pad"
    android:paddingBottom="@dimen/_4sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_68sdp"
        android:background="@drawable/bg_pin_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/wallImage"
            android:layout_width="@dimen/_46sdp"
            android:layout_height="@dimen/_46sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:scaleType="centerCrop"
            android:src="@drawable/wall1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_corner_radius="@dimen/pin_radius_sm" />

        <TextView
            android:id="@+id/namesR"
            style="@style/Pin.Text.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Rainy Sound"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/numbers"
            app:layout_constraintEnd_toStartOf="@+id/durationR"
            app:layout_constraintStart_toEndOf="@+id/wallImage"
            app:layout_constraintTop_toTopOf="@+id/wallImage"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Rainy Sound" />

        <TextView
            android:id="@+id/numbers"
            style="@style/Pin.Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="01"
            app:layout_constraintBottom_toBottomOf="@+id/wallImage"
            app:layout_constraintEnd_toEndOf="@+id/namesR"
            app:layout_constraintStart_toStartOf="@+id/namesR"
            app:layout_constraintTop_toBottomOf="@+id/namesR"
            tools:text="01" />

        <TextView
            android:id="@+id/durationR"
            style="@style/Pin.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6sdp"
            android:text="1:00"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/deleteItem"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1:00" />

        <ImageView
            android:id="@+id/deleteItem"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="Delete recording"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/pin_ink_soft" />

        <View
            android:id="@+id/imageView4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
