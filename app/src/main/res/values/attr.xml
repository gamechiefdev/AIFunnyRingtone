<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="TapHoldUpButton">
        <attr name="thub_ringColor" format="color"/>
        <attr name="thub_ringStrokeWidth" format="dimension"/>
        <attr name="thub_circleColor" format="color"/>
        <attr name="thub_circleColorOhHold" format="color"/>
        <attr name="thub_circleGap" format="dimension"/>
    </declare-styleable>

    <attr name="shapeType" format="enum">
        <enum name="circle" value="1" />
        <enum name="square" value="2" />
        <enum name="heart" value="3" />
    </attr>
    <attr name="progress" format="integer" />
    <attr name="max" format="integer" />
    <attr name="borderWidthSize" format="dimension" />
    <attr name="frontColor" format="color" />
    <attr name="behideColor" format="color" />
    <attr name="borderColor" format="color" />
    <attr name="strong" format="integer" />
    <attr name="textColor" format="color" />
    <attr name="animatorEnable" format="boolean" />
    <attr name="textHidden" format="boolean" />
    <attr name="shapePadding" format="dimension" />

    <declare-styleable name="YPWaveView">
        <attr name="progress" />
        <attr name="max" />
        <attr name="strong" />
        <attr name="frontColor" />
        <attr name="behideColor" />
        <attr name="borderColor" />
        <attr name="borderWidthSize" />
        <attr name="textColor" />
        <attr name="animatorEnable" />
        <attr name="shapeType" />
        <attr name="textHidden" />
        <attr name="shapePadding" />
    </declare-styleable>

    <declare-styleable name="MagicTextView">
        <attr name="innerShadowColor" format="color"/>
        <attr name="innerShadowRadius" format="dimension"/>
        <attr name="innerShadowDx" format="dimension"/>
        <attr name="innerShadowDy" format="dimension"/>

        <attr name="outerShadowColor" format="color"/>
        <attr name="outerShadowRadius" format="dimension"/>
        <attr name="outerShadowDx" format="dimension"/>
        <attr name="outerShadowDy" format="dimension"/>

        <!--<attr name="typeface" format="string" />-->

        <!--<attr name="foreground" format="reference|color"/>
        <attr name="background" format="reference|color"/>-->

        <attr name="strokeWidth" format="dimension" />
        <attr name="strokeMiter" format="dimension" />
        <attr name="strokeColor" format="color" />
        <attr name="strokeJoinStyle">
            <enum name="miter" value="0" />
            <enum name="bevel" value="1" />
            <enum name="round" value="2" />
        </attr>
    </declare-styleable>

</resources>